# Spool LLM configuration (copy to .env and fill in)
# Provider: gemini | openai | anthropic | groq | ollama
SPOOL_LLM_PROVIDER=gemini
SPOOL_LLM_MODEL=gemini-2.5-flash

# Provide the key for your chosen provider (env var fallbacks are also supported):
#   GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: base URL override for Ollama or self-hosted OpenAI-compatible endpoints
# SPOOL_LLM_BASE_URL=http://localhost:11434

# Optional: GitHub personal access token for private repo clones
GITHUB_PAT=